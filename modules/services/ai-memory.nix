# ai-memory server as a hardened system service, via the upstream
# `services.ai-memory` module (flake input `ai-memory`).
#
# Scope split: this module owns only the server. Everything that runs as the
# desktop user — the CLI, the Command Code lifecycle hooks, the stable
# `~/.local/bin/ai-memory-hook` wrapper and the ai-jail maps — stays in
# `user/alsoasnerd/agents.nix`. Hooks write their spool under
# `~/.local/share/ai-memory`, which the service user cannot touch; the
# authoritative db/wiki/models live in `/var/lib/ai-memory` and are reached
# over loopback HTTP like any other client.
{
  ...
}:

{
  # The pepper mixes every api_credentials.token_hash. It was generated by
  # `ai-memory init` when the service was a plain user unit, and rotating it
  # invalidates every stored API key, so the value is carried over verbatim.
  # It cannot live in `settings` (world-readable store, and the module refuses
  # secrets under settings.auth); the env file is the supported path.
  sops.secrets."services/ai-memory/env" = {
    sopsFile = ../../secrets/services.yaml.sops;
  };

  services.ai-memory = {
    enable = true;

    # The package default comes from the input's `nixosModules.default`; the
    # Home Manager CLI names the same derivation, so both profiles agree.
    sopsSecret = "services/ai-memory/env";

    # Loopback only. Hooks and the CLI talk to it over 127.0.0.1:49374, same
    # as the previous user unit.
    bind = "127.0.0.1";
    port = 49374;

    # The old unit hardcoded `--enable-web`; upstream defaults this to false.
    enableWeb = true;

    # Ported 1:1 from the previous ~/.config/ai-memory/config.toml. Keys left
    # out were already at their upstream default. `bind` moves to the
    # top-level option above, and `auth.token_pepper` goes to sops.
    settings = {
      allowed_hosts = [
        "localhost"
        "127.0.0.1"
        "::1"
      ];
      log_level = "info";

      decay = {
        lambda = 0.02;
        sigma = 0.6;
        mu = 0.04;
        salience_default = 1.0;
        cold_threshold = 0.20;
        hard_delete_after_days = 180;
        breadth_weight = 0.0;
        observation_retention_days = 0;
        observation_prune_batch = 5000;
      };

      sanitize = {
        extra_patterns = [ ];
        allowlist = [ ];
      };

      slots.per_user = false;

      consolidation = {
        max_input_tokens = 100000;
        max_output_tokens = 32000;
      };

      auto_improve = {
        require_approval = false;
        min_observations = 8;
        min_session_duration_secs = 120;
        min_confidence = 0.75;
        max_input_tokens = 24000;
        max_proposals_per_run = 5;
        include_raw_fallback = false;
        proposal_actor = "auto_improve";
        pending_path = "_pending/auto-improve";

        eval = {
          enabled = false;
          command = "";
          timeout_secs = 120;
          targets = [
            "_rules"
            "procedures"
          ];
          min_delta = 0.0;
        };

        scheduler = {
          enabled = true;
          interval_secs = 3600;
          max_sessions_per_tick = 1;
          min_session_age_secs = 600;
        };
      };

      routing.mid_session = "follow-cwd";

      # Cookies stay valid on plain loopback HTTP. Non-secret, so it belongs
      # here rather than in the env file.
      auth.secure_cookie = false;
    };
  };
}
